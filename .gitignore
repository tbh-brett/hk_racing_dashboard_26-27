# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/

# Secrets — never commit. Supabase connection string lives here.
.env
.env.*
!.env.example
.streamlit/secrets.toml

# Data stores. The old repo committed these and its .git reached 229 MB.
# The database is rebuildable from scrape; it does not belong in git.
*.db
# SQLite's sidecars. `*.db` does not match them -- the names are hkrd.db-wal and
# hkrd.db-shm -- so both were tracked, on a PUBLIC repo, and a write-ahead log
# is a rolling window of whatever was last written to the database. The three
# commits that carry one hold racing pages and no ledger, but the mechanism
# does not know the difference: import a betting statement, commit anything,
# and the statement rides along in a 3 MB binary nobody reads a diff of.
*.db-wal
*.db-shm
*.db-journal
*.sqlite
*.sqlite3
*.xlsx
*.pkl

# Scraped artefacts — these go in tables, not files (AGENTS.md, Data rules)
reports/
cache/
racecards/

# OS / IDE
.DS_Store
Thumbs.db
.vscode/
.idea/

# pytest
.pytest_cache/

# Editor workspace files. Local to whoever opened the folder.
*.code-workspace
