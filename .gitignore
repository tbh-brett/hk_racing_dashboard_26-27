# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/

# Secrets — never commit. Supabase connection string lives here.
.env
.env.*
!.env.example
.streamlit/secrets.toml

# Data stores. The old repo committed these and its .git reached 229 MB.
# The database is rebuildable from scrape; it does not belong in git.
*.db
# SQLite's sidecars do not match `*.db` and have been committed by accident.
# Two reasons, and the second is the one with teeth: a WAL is 3 MB of the same
# data the rule above exists to keep out -- the old repo's .git reached 229 MB
# -- and it is a rolling window of whatever was written LAST. This repository
# is public. The mechanism cannot tell a betting statement from a race card:
# import one, commit anything, and it rides along inside a binary nobody reads
# a diff of. Audited when the files were untracked: three commits carry a WAL,
# all racing pages, no ledger and no credentials.
*.db-wal
*.db-shm
*.db-journal
*.sqlite
*.sqlite3
*.xlsx
*.pkl

# Scraped artefacts — these go in tables, not files (AGENTS.md, Data rules)
reports/
cache/
racecards/

# OS / IDE
.DS_Store
Thumbs.db
.vscode/
.idea/

# pytest
.pytest_cache/

# Editor workspace files. Local to whoever opened the folder.
*.code-workspace
