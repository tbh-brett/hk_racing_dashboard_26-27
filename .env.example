# Path to the SQLite database. Keep it on the persistent volume, not in the repo.
HKRD_DB=/data/hkrd.db

# Bind address for the API. Uvicorn defaults are fine locally.
HKRD_HOST=127.0.0.1
HKRD_PORT=8000

# ── the password ─────────────────────────────────────────────────────────────
# The dashboard serves the complete betting ledger and the blackbook, so it
# refuses to start without one. Minimum twelve characters, enforced.
#
#   python -c 'import secrets; print(secrets.token_urlsafe(24))'
#
# Changing it signs everyone out: the session cookie is an HMAC keyed by the
# password, so every outstanding cookie fails its signature check immediately.
# HKRD_PASSWORD=

# Run with NO password. Only for a local instance nothing else can reach —
# this is the explicit opt-out that lets the app start without a secret, and
# it exists so that a deploy which merely FORGOT its secret cannot start.
# HKRD_ALLOW_NO_AUTH=1

# The session cookie is Secure by default. Set this only when serving over
# plain HTTP on localhost, where a Secure cookie is never sent back.
# HKRD_INSECURE_COOKIE=1

# ── replication (see ops/litestream.yml and docs/deploy.md) ──────────────────
# Leave unset locally; set as Fly secrets in the deployed environment.
# LITESTREAM_REPLICA_URL=s3://your-bucket/hkrd
# LITESTREAM_ACCESS_KEY_ID=
# LITESTREAM_SECRET_ACCESS_KEY=
# Needed for anything that is not AWS S3 — R2, B2, Tigris:
# LITESTREAM_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# LITESTREAM_REGION=auto
